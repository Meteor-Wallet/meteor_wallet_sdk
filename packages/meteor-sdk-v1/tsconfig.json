{
  "extends": [
    "../../tsconfig.json"
  ],
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "ES2022.Error"
    ],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "target": "ES2022",
    "module": "ES2022",
    "skipLibCheck": true,
    "outDir": "./dist",
    "sourceMap": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "preview/**/*.ts",
    "examples/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "../../node_modules",
    "scripts/consumer-fixture"
  ]
}
