{
  "name": "@meteorwallet/sdk",
  "version": "2.0.0-beta.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "./dist",
    "./src",
    "./package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "docs:build": "rimraf ./docs && typedoc",
    "docs:build_serve": "npm run docs:build && cd ./docs && serve",
    "docs:deploy": "CLOUDFLARE_ACCOUNT_ID=06f0b83df3d52d4d6ddc6512618dca88 npx wrangler pages publish ./docs",
    "prettier": "prettier --write  src/**/*.{js,ts}",
    "preview:action-ui": "node ./preview/action-ui/preview.mjs --open",
    "preview:action-ui:shots": "node ./preview/action-ui/screenshot.mjs",
    "type-check": "tsc --noEmit",
    "type-check-watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@lit/task": "1.0.3",
    "@lit/context": "1.1.6",
    "lit": "3.3.2",
    "@scure/base": "2.0.0",
    "@noble/hashes": "2.0.1",
    "@meteorwallet/errors": "1.28.0-0",
    "@meteorwallet/utils": "1.28.0-0",
    "@meteorwallet/connect": "0.4.2",
    "@meteorwallet/connect-shared": "0.4.2",
    "@nice-code/action": "0.66.1",
    "@nice-code/realm": "0.66.1",
    "@nice-code/util": "0.66.1",
    "@near-js/accounts": "2.2.5",
    "@near-js/crypto": "2.2.5",
    "@near-js/transactions": "2.2.5",
    "@near-js/keystores": "2.2.5",
    "@near-js/keystores-browser": "2.2.5",
    "@near-js/providers": "2.2.5",
    "@near-js/signers": "^2.2.5",
    "@near-js/types": "2.2.5",
    "@near-js/utils": "2.2.5",
    "fast-deep-equal": "3.1.3",
    "@noble/post-quantum": "^0.6.1",
    "borsh": "1.0.0",
    "nanoid": "5.1.5",
    "query-string": "^7.1.3",
    "qr-code-styling": "1.9.2",
    "secp256k1": "5.0.1",
    "zod": "^4.0.17"
  },
  "peerDependencies": {
    "near-api-js": "^6.0.0"
  },
  "devDependencies": {
    "@types/secp256k1": "^4.0.7",
    "esbuild": "0.27.2",
    "near-api-js": "6.2.5",
    "playwright-core": "1.61.1",
    "typedoc": "0.28.16",
    "tsdown": "0.20.1"
  }
}
