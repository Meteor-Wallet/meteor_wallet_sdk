{
  "name": "@meteorwallet/sdk",
  "version": "3.3.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "./dist",
    "./package.json",
    "./README.md",
    "./SECURITY.md"
  ],
  "scripts": {
    "build": "bun run check-key-confinement && bun run check-public-surface && tsdown && bun run check-bundle-size",
    "check-key-confinement": "bun scripts/check-key-confinement.ts",
    "check-public-surface": "bun scripts/check-public-surface.ts",
    "check-bundle-size": "bun scripts/check-bundle-size.ts",
    "check-package-consumable": "bun scripts/check-package-consumable.ts",
    "test": "bun run check-key-confinement && bun run check-public-surface && bun test",
    "build:watch": "tsdown --watch",
    "docs:build": "rimraf ./docs && typedoc",
    "docs:build_serve": "npm run docs:build && cd ./docs && serve",
    "docs:deploy": "CLOUDFLARE_ACCOUNT_ID=06f0b83df3d52d4d6ddc6512618dca88 npx wrangler pages publish ./docs",
    "prettier": "prettier --write  src/**/*.{js,ts}",
    "preview:action-ui": "node ./preview/action-ui/preview.mjs --open",
    "preview:action-ui:shots": "node ./preview/action-ui/screenshot.mjs",
    "type-check": "tsc --noEmit",
    "type-check-watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@lit/task": "1.0.3",
    "@lit/context": "1.1.6",
    "lit": "3.3.2",
    "@scure/base": "2.0.0",
    "@noble/hashes": "2.0.1",
    "@noble/curves": "2.0.1",
    "@meteorwallet/connect": "0.15.0",
    "@meteorwallet/connect-shared": "0.15.0",
    "@nice-code/util": "0.86.0",
    "@near-js/accounts": "2.2.5",
    "@near-js/crypto": "2.2.5",
    "@near-js/transactions": "2.2.5",
    "@near-js/keystores": "2.2.5",
    "@near-js/keystores-browser": "2.2.5",
    "@near-js/providers": "2.2.5",
    "@near-js/signers": "^2.2.5",
    "@near-js/types": "2.2.5",
    "@near-js/utils": "2.2.5",
    "fast-deep-equal": "3.1.3",
    "@noble/post-quantum": "^0.6.1",
    "borsh": "1.0.0",
    "nanoid": "5.1.5",
    "query-string": "^7.1.3",
    "qr-code-styling": "1.9.2",
    "valibot": "1.4.2",
    "secp256k1": "5.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/secp256k1": "^4.0.7",
    "esbuild": "0.27.2",
    "playwright-core": "1.61.1",
    "tsdown": "0.20.1",
    "typedoc": "0.28.16"
  }
}