{
  "name": "@meteorwallet/public-sdk-repo",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "bun run --parallel dev:near-connect-build dev:demo dev:mc-backend dev:web-wallet",
    "dev:full": "bun run --parallel dev:near-connect-build dev:demo dev:backend-test dev:near-connect dev:sdk-preview dev:sdk-build-watch",
    "dev:transfer": "bun run --parallel dev:near-connect-build dev:demo dev:mc-backend",
    "dev:demo": "bun run --cwd packages/meteor-sdk-v1-test-web dev",
    "dev:backend-test": "bun run --cwd packages/meteor-sdk-backend-test dev",
    "dev:near-connect": "bun run --cwd packages/meteor-near-connect dev",
    "dev:near-connect-build": "bun run --cwd packages/meteor-near-connect build-dev-watch",
    "dev:sdk-preview": "cd packages/meteor-sdk-v1 && node ./preview/action-ui/preview.mjs",
    "dev:sdk-build-watch": "bun run --cwd packages/meteor-sdk-v1 build:watch",
    "dev:mc-backend": "bun run --cwd ../meteor-connect-bridge/packages/meteor-connect-backend dev",
    "dev:web-wallet": "bun run --cwd ../meteor_wallet/web/packages/meteor-frontend web:dev",
    "checks": "bun run --cwd packages/meteor-sdk-v1 type-check && bun run --cwd packages/meteor-sdk-v1 check-key-confinement && cd packages/meteor-sdk-v1 && bun test",
    "format": "bunx biome format --write",
    "uniform-update": "bunx monoutil@latest uniform_update",
    "type-check-all": "bun run --parallel --workspaces --no-exit-on-error type-check",
    "type-check-watch-all": "bun run --parallel --workspaces --no-exit-on-error type-check-watch",
    "release": "bun run scripts/release.ts",
    "release:dry": "bun run scripts/release.ts --dry-run",
    "clean-files": "bunx glcl",
    "clean-cache-files": "bunx glcl -f glob-list.caches.clean",
    "clean-hot-labs-near-connect": "bunx glcl -f glob-list.hot-labs-near-connect.clean",
    "link-local-packages-watch": "bunx local-package-link@0.1.0 --watch",
    "link-local-packages": "bunx local-package-link@0.1.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@types/bun": "latest",
    "@types/chrome": "0.1.3",
    "tsdown": "0.14.1",
    "typescript": "5.9.3"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "patchedDependencies": {
    "@near-js/transactions@2.2.5": "patches/@near-js%2Ftransactions@2.2.5.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "koffi"
  ]
}
